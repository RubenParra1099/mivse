# Cadena de conexión de Neon (usa la "pooled" en Vercel).
# Si no se define, la plataforma arranca en MODO DEMO con 7,000 egresados simulados en memoria.
DATABASE_URL=postgresql://usuario:contraseña@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Identidad institucional usada en los mensajes de WhatsApp
NEXT_PUBLIC_INSTITUCION=Universidad
NEXT_PUBLIC_AREA_EGRESADOS=Coordinación de Egresados
