{
  "name": "mivse",
  "version": "2.0.0",
  "private": true,
  "description": "MIVSE — Plataforma de Call Center y Tablero de Control del Modelo Integral de Vinculación y Seguimiento de Egresados",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
